# Keep model caches inside the repository so cleanup is one-directory removal.
HF_HOME=.cache/huggingface
HUGGINGFACE_HUB_CACHE=.cache/huggingface/hub
TRANSFORMERS_CACHE=.cache/huggingface/transformers
PADDLE_HOME=.cache/paddle
PADDLEOCR_HOME=.cache/paddleocr

# CPU is the reproducible default for the first benchmark run.
BENCHMARK_DEVICE=cpu

# End-to-end pipeline LLM extractor. Copy this file to .env (gitignored) and fill both in.
# The model ID is a placeholder: pick one from https://openrouter.ai/models that supports
# structured outputs. The pipeline falls back to json_object mode if the provider rejects
# a strict json_schema request, and validates the response locally either way.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
